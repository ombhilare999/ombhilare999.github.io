<div class="news">
  {% if site.news != blank %}
    {% assign news_all = site.news | reverse %}
    {% assign news_size = site.news | size %}
    {% if include.limit %}
      {% assign news_limit = 1 %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div class="news-timeline">
      {% for item in news_all limit: news_limit %}
        <div class="news-item">
          <div class="news-date-badge">{{ item.date | date: '%b %Y' }}</div>
          <div class="news-content">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if include.limit and news_size > news_limit %}
      <a class="see-more-link" href="{{ '/news/' | relative_url }}">
        +{{ news_size | minus: news_limit }} more &rarr;
      </a>
    {% endif %}
  {% else %}
    <p class="text-muted" style="font-size:0.8rem;">No news yet.</p>
  {% endif %}
</div>
