<div class="news-timeline">
  {% assign all_posts = site.posts %}
  {% assign posts_size = all_posts | size %}
  {% if include.limit %}
    {% assign posts_limit = 1 %}
  {% else %}
    {% assign posts_limit = posts_size %}
  {% endif %}
  {% if posts_size > 0 %}
    {% for item in all_posts limit: posts_limit %}
      <div class="news-item">
        <div class="news-date-badge">{{ item.date | date: '%b %Y' }}</div>
        <div class="news-content">
          {% if item.redirect == blank %}
            <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% elsif item.redirect contains '://' %}
            <a class="news-title" href="{{ item.redirect }}" target="_blank">{{ item.title }}</a>
          {% else %}
            <a class="news-title" href="{{ item.redirect | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% if include.limit and posts_size > posts_limit %}
      <a class="see-more-link" href="{{ '/blog/' | relative_url }}">
        +{{ posts_size | minus: posts_limit }} more &rarr;
      </a>
    {% endif %}
  {% else %}
    <p class="text-muted" style="font-size:0.8rem;">No posts yet.</p>
  {% endif %}
</div>
