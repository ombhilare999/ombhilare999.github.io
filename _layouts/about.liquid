---
layout: default
---
<div class="post">
  <div class="about-layout">

    <!-- ── Left sidebar ─────────────────────────────────────────────── -->
    <aside class="about-sidebar">

      {% if page.profile and page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle sidebar-photo' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded sidebar-photo' %}
        {% endif %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class=profile_image_class
          sizes="(min-width: 768px) 220px, 50vw" alt=page.profile.image cache_bust=true
        %}
      {% endif %}

      <h1 class="sidebar-name">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      <p class="sidebar-subtitle">{{ page.subtitle }}</p>

      {% if page.profile and page.profile.more_info %}
        <div class="sidebar-info">{{ page.profile.more_info }}</div>
      {% endif %}

      <!-- CV + Resume buttons -->
      <div class="sidebar-buttons">
        <a class="sidebar-btn" href="{{ '/Omkar_Bhilare_CV.pdf' | relative_url }}" target="_blank">CV</a>
        <a class="sidebar-btn" href="{{ '/Omkar_Bhilare_RESUME.pdf' | relative_url }}" target="_blank">Resume</a>
      </div>

      <!-- News -->
      {% if page.news and site.announcements.enabled %}
        <h2 class="section-heading sidebar-section-heading">
          <a href="{{ '/news/' | relative_url }}">news</a>
        </h2>
        {% include news.liquid limit=true %}
      {% endif %}

      <!-- Latest posts -->
      {% if site.latest_posts.enabled %}
        <h2 class="section-heading sidebar-section-heading">
          <a href="{{ '/blog/' | relative_url }}">latest posts</a>
        </h2>
        {% include latest_posts.liquid limit=true %}
      {% endif %}

      <!-- Social icons at the bottom -->
      {% if page.social %}
        <div class="sidebar-social-divider"></div>
        <div class="sidebar-social">{% include social.liquid %}</div>
      {% endif %}

    </aside>

    <!-- ── Right main content ────────────────────────────────────────── -->
    <main class="about-main">

      <div class="about-body">{{ content }}</div>

      <!-- Research interests -->
      {% if page.research_interests %}
        <div class="research-interests">
          {% for interest in page.research_interests %}
            <span class="interest-chip">{{ interest }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Selected papers -->
      {% if page.selected_papers %}
        <h2 class="section-heading">
          <a href="{{ '/publications/' | relative_url }}">selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      {% endif %}

    </main>

  </div>
</div>
